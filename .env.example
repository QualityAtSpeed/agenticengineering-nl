RESEND_API_KEY=
CONTACT_EMAIL=hello@agenticengineering.nl
CONTACT_FROM_EMAIL=noreply@agenticengineering.nl

# E2E live-API contact test (optional, CI only). When E2E_LIVE_API=1, the
# Playwright contact spec posts a real form to /api/contact instead of
# mocking the route. Use Resend's sandbox addresses to avoid real delivery:
#   CONTACT_EMAIL=delivered@resend.dev
#   CONTACT_FROM_EMAIL=onboarding@resend.dev
# Provision a dedicated Resend API key (not the production one) and store it
# as the RESEND_API_KEY_E2E GitHub Actions secret.
E2E_LIVE_API=

# set to true to enable the blogs feature. The blogs redirect to a website which is still in development
BLOGS_ENABLED=false

# set to true to enable the homepage testimonials section. Stays hidden in
# production until real testimonials replace the placeholder content.
TESTIMONIALS_ENABLED=false

# Stripe (pilot booking + payment). Use test-mode keys locally and in CI.
# STRIPE_SECRET_KEY: server-side API key (sk_test_… / sk_live_…)
# STRIPE_PUBLISHABLE_KEY: client-safe key (pk_test_… / pk_live_…)
# STRIPE_WEBHOOK_SECRET: signing secret for /api/stripe/webhook (whsec_…)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
